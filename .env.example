DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Generate at least 24 random characters, e.g. openssl rand -hex 24.
ORGANIZER_PASSWORD=
# Server-only Google AI Studio key for the Gemini API.
GEMINI_API_KEY=
# Optional override for the production Cloud Run judge. Default: gemini-3.5-flash-lite.
JUDGE_MODEL=
# Only used by the legacy Vercel Sandbox rehearsal.
JUDGE_SNAPSHOT_ID=
