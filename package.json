{
  "name": "mini-hackathon-judge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup.mjs",
    "sandbox:prepare": "node --env-file-if-exists=.env.local scripts/prepare-sandbox.mjs",
    "test:rehearsal": "vitest run tests/workflow.rehearsal.spec.ts",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/sandbox": "^5.0.0",
    "ai": "^6.0.338",
    "lucide-react": "^1.82.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workflow": "^5.8.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "zod": "$zod",
    "minimatch@10": "^11.0.1"
  }
}
